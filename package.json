{
  "name": "jsonl-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "build": "bun build ./src/index.html ./src/bulk-analyzer.html ./src/share.html --outdir=dist --sourcemap --target=browser --minify --define:process.env.NODE_ENV='\"production\"' --env='BUN_PUBLIC_*'",
    "gen:docs": "bun scripts/gen-docs.ts",
    "gen:og": "bun scripts/gen-og.ts",
    "migrate": "bun src/server/migrate.ts",
    "db:reset": "bun src/server/db-reset.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "cli:build": "cd cli && bun run build"
  },
  "dependencies": {
    "@uiw/react-json-view": "^2.0.0-alpha.41",
    "dompurify": "^3.3.1",
    "idb-keyval": "^6.2.5",
    "modern-screenshot": "^4.6.8",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.15.0",
    "@types/bun": "latest",
    "@types/dompurify": "^3.2.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "fake-indexeddb": "^6.2.5",
    "marked": "^18.0.5"
  }
}
