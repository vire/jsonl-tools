# Copy to .env and fill in. Bun auto-loads .env (it is gitignored).
# Never prefix a secret with BUN_PUBLIC_ — that would inline it into the browser bundle.

# Postgres the app connects to. The port must match where Postgres actually listens.
DATABASE_URL=postgres://postgres:devpass@localhost:5487/jsonl

# Long random secret; salts the stored uploader/reporter IP hashes (required in prod).
IP_HASH_SALT=change-me-in-prod

# Set to 1 when the app runs behind a TLS-terminating reverse proxy.
# TRUSTED_PROXY=1

# GitHub OAuth App — only needed for sign-in / durable history.
# Create one at GitHub → Settings → Developer settings → OAuth Apps.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback
